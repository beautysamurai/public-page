+#!/usr/bin/env python3
+"""Stage and verify producer-complete reviewed bundles for startup sync.
+
+A producer writes both reviewed JSON snapshots into a fresh sibling directory,
+then writes ``bundle.ready.json`` last and atomically renames the directory into
+the configured inbox. The consumer verifies the manifest hashes after claiming
+and snapshotting the directory, so mixed export generations fail closed.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import shutil
+import sys
+import uuid
+from pathlib import Path
+from typing import Any, Sequence
+
+MAX_BYTES = 16 * 1024 * 1024
+HISTORY_NAME = "chatgpt_scheduler_history.json"
+TRANSLATION_NAME = "en.json"
+MANIFEST_NAME = "bundle.ready.json"
+MANIFEST_FIELDS = frozenset(
+    {"schemaVersion", "historySha256", "translationSha256"}
+)
+SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")
+
+
+class HandoffError(RuntimeError):
+    """The local producer/consumer handoff is incomplete or inconsistent."""
+
+
+def _reject_duplicate_json_keys(
+    pairs: list[tuple[str, Any]],
+) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise HandoffError(f"JSON contains duplicate key {key!r}")
+        result[key] = value
+    return result
+
+
+def _read_file(path: Path) -> bytes:
+    if path.is_symlink():
+        raise HandoffError(f"handoff files must not be symbolic links: {path}")
+    try:
+        raw = path.read_bytes()
+    except OSError as exc:
+        raise HandoffError(f"cannot read handoff file: {path}") from exc
+    if len(raw) > MAX_BYTES:
+        raise HandoffError(f"handoff file exceeds {MAX_BYTES} bytes: {path}")
+    return raw
+
+
+def _sha256(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def build_manifest(history: bytes, translation: bytes) -> dict[str, Any]:
+    return {
+        "schemaVersion": 1,
+        "historySha256": _sha256(history),
+        "translationSha256": _sha256(translation),
+    }
+
+
+def _manifest_bytes(manifest: dict[str, Any]) -> bytes:
+    return (
+        json.dumps(manifest, ensure_ascii=False, indent=2, allow_nan=False) + "\n"
+    ).encode("utf-8")
+
+
+def load_manifest(path: Path) -> dict[str, Any]:
+    raw = _read_file(path)
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise HandoffError("handoff manifest must be UTF-8") from exc
+    try:
+        value = json.loads(text, object_pairs_hook=_reject_duplicate_json_keys)
+    except json.JSONDecodeError as exc:
+        raise HandoffError("handoff manifest is not valid JSON") from exc
+    if not isinstance(value, dict):
+        raise HandoffError("handoff manifest must be a JSON object")
+    actual = frozenset(value)
+    if actual != MANIFEST_FIELDS:
+        missing = sorted(MANIFEST_FIELDS - actual)
+        unknown = sorted(actual - MANIFEST_FIELDS)
+        raise HandoffError(
+            "handoff manifest has invalid fields; "
+            f"missing={missing}, unknown={unknown}"
+        )
+    schema_version = value["schemaVersion"]
+    if type(schema_version) is not int or schema_version != 1:
+        raise HandoffError("handoff manifest schemaVersion must be integer 1")
+    for field in ("historySha256", "translationSha256"):
+        digest = value[field]
+        if not isinstance(digest, str) or SHA256_RE.fullmatch(digest) is None:
+            raise HandoffError(f"handoff manifest {field} must be lowercase SHA-256")
+    return value
+
+
+def verify_manifest(
+    manifest_path: Path,
+    history_path: Path,
+    translation_path: Path,
+) -> dict[str, Any]:
+    manifest = load_manifest(manifest_path)
+    history = _read_file(history_path)
+    translation = _read_file(translation_path)
+    actual_history = _sha256(history)
+    actual_translation = _sha256(translation)
+    if actual_history != manifest["historySha256"]:
+        raise HandoffError(
+            "reviewed history does not match the producer-complete manifest"
+        )
+    if actual_translation != manifest["translationSha256"]:
+        raise HandoffError(
+            "English overlay does not match the producer-complete manifest"
+        )
+    return manifest
+
+
+def _write_new(path: Path, content: bytes) -> None:
+    with path.open("xb") as handle:
+        handle.write(content)
+        handle.flush()
+        os.fsync(handle.fileno())
+
+
+def _fsync_directory(path: Path) -> None:
+    flags = os.O_RDONLY
+    if hasattr(os, "O_DIRECTORY"):
+        flags |= os.O_DIRECTORY
+    try:
+        descriptor = os.open(path, flags)
+    except OSError:
+        return
+    try:
+        os.fsync(descriptor)
+    except OSError:
+        pass
+    finally:
+        os.close(descriptor)
+
+
+def stage_bundle(
+    history_source: Path,
+    translation_source: Path,
+    inbox: Path,
+) -> Path:
+    """Create a complete sibling directory and atomically publish it as inbox."""
+
+    history = _read_file(history_source)
+    translation = _read_file(translation_source)
+    manifest = _manifest_bytes(build_manifest(history, translation))
+
+    parent = inbox.parent
+    parent.mkdir(parents=True, exist_ok=True)
+    if inbox.exists():
+        raise HandoffError(f"review inbox already exists: {inbox}")
+
+    staging = parent / f".{inbox.name}.staging-{uuid.uuid4().hex}"
+    try:
+        staging.mkdir()
+        _write_new(staging / HISTORY_NAME, history)
+        _write_new(staging / TRANSLATION_NAME, translation)
+        # The readiness manifest is deliberately written last. A consumer only
+        # considers a directory eligible after this file exists.
+        _write_new(staging / MANIFEST_NAME, manifest)
+        _fsync_directory(staging)
+        try:
+            os.replace(staging, inbox)
+        except OSError as exc:
+            raise HandoffError(
+                "could not atomically rename the staged bundle into the inbox"
+            ) from exc
+        _fsync_directory(parent)
+    except Exception:
+        if staging.exists():
+            shutil.rmtree(staging, ignore_errors=True)
+        raise
+    return inbox
+
+
+def build_argument_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    stage = subparsers.add_parser(
+        "stage",
+        help="atomically stage reviewed source and English snapshots",
+    )
+    stage.add_argument("--history", type=Path, required=True)
+    stage.add_argument("--translation", type=Path, required=True)
+    stage.add_argument(
+        "--inbox",
+        type=Path,
+        default=Path(".local/inbox/public-review"),
+    )
+
+    verify = subparsers.add_parser(
+        "verify",
+        help="verify that one claimed snapshot matches its readiness manifest",
+    )
+    verify.add_argument("--manifest", type=Path, required=True)
+    verify.add_argument("--history", type=Path, required=True)
+    verify.add_argument("--translation", type=Path, required=True)
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = build_argument_parser().parse_args(argv)
+    try:
+        if args.command == "stage":
+            destination = stage_bundle(args.history, args.translation, args.inbox)
+            print(f"staged producer-complete reviewed bundle: {destination}")
+        else:
+            verify_manifest(args.manifest, args.history, args.translation)
+            print("reviewed bundle handoff manifest is valid")
+    except (HandoffError, OSError) as exc:
+        print(f"public_review_handoff: {exc}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
