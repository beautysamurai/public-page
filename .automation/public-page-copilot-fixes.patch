+
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPTS = ROOT / "scripts"
+if str(SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(SCRIPTS))
+
+import public_review_handoff as handoff  # noqa: E402
+
+
+class PublicReviewHandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.root = Path(self.temporary.name)
+        self.history = self.root / "reviewed-history.json"
+        self.translation = self.root / "reviewed-en.json"
+        self.history.write_text(
+            '{"schemaVersion":2,"editions":[]}\n', encoding="utf-8"
+        )
+        self.translation.write_text(
+            '{"schemaVersion":1,"language":"en","editions":[]}\n',
+            encoding="utf-8",
+        )
+        self.inbox = self.root / "inbox" / "public-review"
+
+    def tearDown(self):
+        self.temporary.cleanup()
+
+    def test_stage_writes_manifest_last_and_verified_hashes(self):
+        destination = handoff.stage_bundle(
+            self.history,
+            self.translation,
+            self.inbox,
+        )
+        self.assertEqual(destination, self.inbox)
+        self.assertEqual(
+            {path.name for path in self.inbox.iterdir()},
+            {
+                handoff.HISTORY_NAME,
+                handoff.TRANSLATION_NAME,
+                handoff.MANIFEST_NAME,
+            },
+        )
+        manifest = handoff.verify_manifest(
+            self.inbox / handoff.MANIFEST_NAME,
+            self.inbox / handoff.HISTORY_NAME,
+            self.inbox / handoff.TRANSLATION_NAME,
+        )
+        self.assertEqual(manifest["schemaVersion"], 1)
+        self.assertRegex(manifest["historySha256"], r"^[0-9a-f]{64}$")
+        self.assertRegex(manifest["translationSha256"], r"^[0-9a-f]{64}$")
+        self.assertFalse(
+            any(path.name.startswith(".public-review.staging-") for path in self.inbox.parent.iterdir())
+        )
+
+    def test_verify_rejects_mixed_export_generations(self):
+        handoff.stage_bundle(self.history, self.translation, self.inbox)
+        translation = self.inbox / handoff.TRANSLATION_NAME
+        translation.write_text(
+            '{"schemaVersion":1,"language":"en","editions":[{}]}\n',
+            encoding="utf-8",
+        )
+        with self.assertRaisesRegex(
+            handoff.HandoffError,
+            "does not match the producer-complete manifest",
+        ):
