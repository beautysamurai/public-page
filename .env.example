# Copy this file to .env for local runs. Never commit .env.
OPENAI_API_KEY=
OPENAI_SCREENING_MODEL=gpt-5.6-luna
OPENAI_FULL_TEXT_MODEL=gpt-5.6-terra
OPENAI_WEEKLY_MODEL=gpt-5.6-terra
OPENAI_MONTHLY_MODEL=gpt-5.6-sol
OPENAI_SCREENING_REASONING_EFFORT=low
OPENAI_FULL_TEXT_REASONING_EFFORT=medium
OPENAI_WEEKLY_REASONING_EFFORT=medium
OPENAI_MONTHLY_REASONING_EFFORT=high
OPENAI_PDF_DETAIL=low
OPENAI_RESPONSES_TIMEOUT_SECONDS=120
RESEARCH_DAILY_TIME_BUDGET_SECONDS=1800
OPENAI_SYNTHESIS_CHUNK_MAX_ITEMS=20
OPENAI_SYNTHESIS_CHUNK_MAX_BYTES=200000
